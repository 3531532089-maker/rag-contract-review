# ============================================================
# 环境变量配置模板
# 使用方法：复制本文件为 backend/.env 并填入真实值
#   cp .env.example .env
# ============================================================

# ===== 大语言模型 API（必填）=====
# 支持 OpenAI 或任何兼容 OpenAI 接口的服务（DeepSeek、通义、Kimi、Ollama 等）
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# ===== 管理员认证（必填）=====
# 管理员登录密码的 SHA-256 哈希值，生成方式：
#   python -c "import hashlib; print(hashlib.sha256(b'你的密码').hexdigest())"
ADMIN_PASSWORD_HASH=

# JWT 签名密钥，生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ===== 数据库 =====
# 留空则默认使用本地 SQLite（无需额外安装）
# 生产环境可切换为 PostgreSQL，例如：
#   DATABASE_URL=postgresql://user:password@localhost:5432/contract_review
DATABASE_URL=

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ===== 文本切片 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ===== 合同审查 =====
# 发送给 LLM 的合同文本最大字符数（0=不限制）
REVIEW_MAX_CHARS=15000

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Embedding 模型 =====
# 中文向量模型（首次运行会自动下载）
# 如遇下载问题，可设置 HuggingFace 镜像：
#   HF_ENDPOINT=https://hf-mirror.com

# ===== ChromaDB 向量库 =====
# 开发模式：本地文件存储（默认，无需配置）
# 生产模式：连接独立 ChromaDB Server，取消注释并填写：
#   CHROMA_SERVER_HOST=http://localhost
#   CHROMA_SERVER_PORT=8000
